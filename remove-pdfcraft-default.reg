Windows Registry Editor Version 5.00

; -------------------------------------------------------------
; Remove stale PDFCraft file association and default registrations
; -------------------------------------------------------------

; 1. Delete the PDFCraft ProgId definition
[-HKEY_CURRENT_USER\Software\Classes\PDFCraft.Doc.PDF]

; 2. Delete the Applications\pdfcraft.exe registration
[-HKEY_CURRENT_USER\Software\Classes\Applications\pdfcraft.exe]

; 3. Clear default association and ProgId link under HKCU .pdf
[HKEY_CURRENT_USER\Software\Classes\.pdf]
@=-

[HKEY_CURRENT_USER\Software\Classes\.pdf\OpenWithProgids]
"PDFCraft.Doc.PDF"=-

; 4. Clear Explorer UserChoice and OpenWith registrations
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\OpenWithProgids]
"PDFCraft.Doc.PDF"=-
"Applications\\pdfcraft.exe"=-

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\UserChoiceLatest]

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\UserChoice]

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\OpenWithList]
"f"=-

; 5. Clear Windows notification toast flag
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ApplicationAssociationToasts]
"PDFCraft.Doc.PDF_.pdf"=-
